[Unit]
Description=Legalok API (Express + TypeORM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=legalok
WorkingDirectory=/opt/legalok/server
EnvironmentFile=/opt/legalok/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/legalok.log
StandardError=append:/var/log/legalok.err.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/legalok/server/data

[Install]
WantedBy=multi-user.target
