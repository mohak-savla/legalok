# ---- Legalok client (build-time variables, set in Cloudflare Pages → Settings → Environment) ----

# Full API origin INCLUDING /api prefix (tunnel/VM URL in production).
# Leave unset in local dev — vite proxies /api to localhost:4000.
# VITE_API_BASE_URL=https://api-yourdomain.trycloudflare.com/api

# Supabase Auth (enables real Google/Facebook login buttons when both are set)
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon/public key from Supabase → Settings → API>
