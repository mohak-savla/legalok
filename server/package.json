{
  "name": "legalok-server",
  "version": "1.0.0",
  "private": true,
  "description": "Legalok API — Express + TypeORM (SQLite dev / PostgreSQL prod-ready)",
  "scripts": {
    "dev": "node -r ts-node/register/transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
