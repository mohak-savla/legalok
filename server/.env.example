# ---- Legalok server ----
NODE_ENV=production
PORT=4000

# Strong random secrets (generate: openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Postgres (Supabase → Project Settings → Database → Connection string → URI, use the pooler host)
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# DB_SYNCHRONIZE=true

# Supabase Auth (server-side token verification)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon/public key>

# Public URLs (used in emails / guest signing links / CORS)
APP_URL=https://legalok.pages.dev
CORS_ORIGIN=https://legalok.pages.dev

# Mock payment gateway (replace with real Razorpay keys when going paid)
RAZORPAY_KEY_ID=rzp_test_mock_legalok
RAZORPAY_KEY_SECRET=legalok_mock_gateway_secret
SIGNING_EXPIRY_DAYS=7
